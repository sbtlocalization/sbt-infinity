filters:
  and:
    - file.inFolder("docs/adr")
properties:
  note.status:
    displayName: status
  file.name:
    displayName: name
views:
  - type: table
    name: актуальні
    filters:
      and:
        - note["adr-status"] != "Superseded"
    order:
      - adr-status
      - file.name
      - file.ctime
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 591
  - type: table
    name: all
    order:
      - adr-status
      - file.name
      - superseded-by
      - file.ctime
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 566
      note.superseded-by: 224
